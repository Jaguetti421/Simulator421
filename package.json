{
  "name": "lastclan",
  "version": "0.0.0",
  "private": true,
  "description": "The Last Clan — web build (browser survival god game). npm workspace root.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build --config apps/web/vite.config.ts",
    "clean": "node scripts/clean.js",
    "test": "vitest run",
    "test:tools": "python3 -m unittest discover -s tools -p test_tools.py -v",
    "lint": "eslint .",
    "site:dev": "vite --config apps/web/vite.config.ts",
    "lab": "node packages/lab/dist/cli/index.js",
    "fixtures": "node packages/lab/dist/cli/index.js validate --fixture contracts/examples",
    "screens": "playwright test tests/playwright/capture.spec.ts",
    "check:workboard": "python3 tools/check_workboard.py",
    "verify": "npm run build && npm run lint && npm test && npm run test:tools && npm run check:workboard",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@thi.ng/random": "4.1.54",
    "@types/node": "22.20.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.2",
    "ajv": "8.20.0",
    "canvas": "^3.2.0",
    "eslint": "10.10.0",
    "fake-indexeddb": "6.2.2",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.1.5",
    "vitest": "5.0.0"
  }
}
