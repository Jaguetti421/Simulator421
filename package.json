{
  "name": "lastclan",
  "version": "0.0.0",
  "private": true,
  "description": "The Last Clan \u2014 web build (browser survival god game). npm workspace root.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "node scripts/clean.js",
    "test": "vitest run",
    "test:tools": "python3 -m unittest discover -s tools -p test_tools.py -v",
    "lint": "eslint .",
    "lab": "node packages/lab/dist/cli/index.js",
    "fixtures": "node packages/lab/dist/cli/index.js validate --fixture contracts/examples",
    "screens": "node -e \"console.log('screens: BLOCKED_RENDER until W0-10 (no /capture route, no Playwright job yet)'); process.exit(0)\"",
    "check:workboard": "python3 tools/check_workboard.py",
    "verify": "npm run build && npm run lint && npm test && npm run test:tools && npm run check:workboard"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@thi.ng/random": "4.1.54",
    "@types/node": "22.20.2",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
