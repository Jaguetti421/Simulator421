# dependencies
node_modules/
# build output
dist/
*.tsbuildinfo
# tool caches and logs
.eslintcache
.vite/
.vitest/
coverage/
npm-debug.log*
*.log
# ...but a run log that is committed handoff evidence is part of the record
!/handoffs/**/*.log
# python
__pycache__/
*.pyc
# OS / editor
.DS_Store
Thumbs.db
# evidence outputs are committed only where a card requires a checked-in reproducible artifact
/handoffs/**/tmp/
# clanlab run evidence: logs and failure bundles are regenerated, never committed
/clanlab-out/
# archives produced for the round-trip are presented from the outputs folder, never committed
/lastclan-*.zip
# playwright run output
/test-results/
/playwright-report/
# vite output for apps/web (rebuilt by npm run build)
/apps/web/dist-site/
/tools/eslint/dist/
