{
 "$comment": "Golden sample manifest for contract design version 0 (W0-04). 'accept' samples must validate, decode and re-encode byte-identically (canonical form). 'reject' samples must be refused. 'enforcedBy' says which layer catches it: 'schema' = the emitted JSON Schema alone is enough (checked with an independent JSON Schema validator); 'refinement' = a cross-field invariant that JSON Schema cannot express, carried in x-refinements and enforced by the contract validator. Files marked accept are generated by tools/gen_contract_artifacts.mjs; reject files are hand-written.",
 "contractVersion": 0,
 "samples": [
  { "file": "player-command.valid.json", "record": "PlayerCommand", "expect": "accept" },
  { "file": "command-ack.accepted.valid.json", "record": "CommandAck", "expect": "accept" },
  { "file": "command-ack.rejected.valid.json", "record": "CommandAck", "expect": "accept" },
  { "file": "committed-event.valid.json", "record": "CommittedEvent", "expect": "accept" },
  { "file": "decision-trace.valid.json", "record": "DecisionTrace", "expect": "accept" },
  { "file": "render-snapshot.valid.json", "record": "RenderSnapshot", "expect": "accept" },
  { "file": "final-result.valid.json", "record": "FinalResult", "expect": "accept" },
  { "file": "route-result.partial.valid.json", "record": "RouteResult", "expect": "accept" },
  { "file": "route-result.budget-exhausted.valid.json", "record": "RouteResult", "expect": "accept" },
  { "file": "damage-proposal.valid.json", "record": "DamageProposal", "expect": "accept" },
  { "file": "action-result.failed.valid.json", "record": "ActionResult", "expect": "accept" },
  { "file": "content-profile.valid.json", "record": "ContentProfile", "expect": "accept" },

  { "file": "player-command.unknown-version.json", "record": "PlayerCommand", "expect": "reject", "enforcedBy": "schema", "note": "schemaVersion 1 is not implemented; a decoder must refuse rather than guess" },
  { "file": "committed-event.unknown-version.json", "record": "CommittedEvent", "expect": "reject", "enforcedBy": "schema", "note": "schemaVersion 2 is not implemented" },
  { "file": "player-command.reject-unknown-field.json", "record": "PlayerCommand", "expect": "reject", "enforcedBy": "schema", "note": "assignedTick is the simulation's to assign; contract records are closed" },
  { "file": "player-command.reject-bad-actor-id.json", "record": "PlayerCommand", "expect": "reject", "enforcedBy": "schema", "note": "runId with spaces violates the durable-ID pattern" },
  { "file": "committed-event.reject-bad-stage.json", "record": "CommittedEvent", "expect": "reject", "enforcedBy": "schema", "note": "there are ten tick stages" },
  { "file": "command-ack.reject-accepted-with-reason.json", "record": "CommandAck", "expect": "reject", "enforcedBy": "refinement", "note": "no false successful UI state: an accepted ack carries no rejection reason" },
  { "file": "command-ack.reject-rejected-without-reason.json", "record": "CommandAck", "expect": "reject", "enforcedBy": "refinement", "note": "a rejection must be explainable" },
  { "file": "decision-trace.reject-chosen-not-evaluated.json", "record": "DecisionTrace", "expect": "reject", "enforcedBy": "refinement", "note": "the chosen candidate must be among the candidates actually evaluated" },
  { "file": "route-result.reject-budget-exhausted-with-path.json", "record": "RouteResult", "expect": "reject", "enforcedBy": "refinement", "note": "INTERFACES.md: budget exhaustion cannot masquerade as a useful path" },
  { "file": "route-result.reject-partial-without-portal.json", "record": "RouteResult", "expect": "reject", "enforcedBy": "refinement", "note": "Partial requires a certified nearer portal and a stable progress measure" },
  { "file": "final-result.reject-two-winners.json", "record": "FinalResult", "expect": "reject", "enforcedBy": "refinement", "note": "a match has at most one winner" },
  { "file": "render-snapshot.reject-buffer-length.json", "record": "RenderSnapshot", "expect": "reject", "enforcedBy": "refinement", "note": "byteLength must equal actorCount x strideBytes or the renderer would read past the buffer" },
  { "file": "damage-proposal.reject-two-sources.json", "record": "DamageProposal", "expect": "reject", "enforcedBy": "refinement", "note": "damage has exactly one source" }
 ]
}
